#!/usr/bin/env python3
"""sbom — Service Bill of Materials for a Stripe Projects stack.

Never reads .env or the vault. Credential previews come from
`stripe projects env --json`, which the CLI already redacts.
"""
import argparse
import datetime as dt
import html
import json
import os
import re
import subprocess
import sys
import uuid
from pathlib import Path

ROOT = Path.cwd()
STATE_DIR = ROOT / ".sbom"
LEDGER = STATE_DIR / "ledger.json"
CATALOG_CACHE = STATE_DIR / "catalog.json"
CDX_OUT = ROOT / "sbom.cdx.json"
HTML_OUT = ROOT / "report.html"
DEFAULT_MAX_AGE = int(os.environ.get("SBOM_MAX_AGE_DAYS", "30"))

SKIP_DIRS = {".git", "site", ".projects", ".sbom", ".agents", ".claude", ".cursor", "node_modules", "__pycache__"}
SKIP_FILES = {".env", "sbom", "sbom.cdx.json", "report.html", "AGENTS.md", "CLAUDE.md"}

SECRET_RE = re.compile(r"(KEY|SECRET|TOKEN|PASSWORD|CONNECTION_STRING|DSN|ENVIRONMENTS)$")

SEVERITY = {"database": "critical", "auth": "critical", "payments": "high", "ai": "high",
            "email": "high", "storage": "high", "analytics": "medium", "observability": "medium",
            "feature_flags": "medium", "compute": "high", "hosting": "high", "cdn": "high"}
SEV_RANK = {"critical": 4, "high": 3, "medium": 2, "low": 1}

IMPACT = {
    "database": "Full read/write access to customer data; an attacker can dump or drop every table.",
    "auth": "Can impersonate any user, mint sessions and read your entire user directory.",
    "ai": "Attacker runs LLM calls billed to you: unbounded spend, plus prompt/response data exposure.",
    "payments": "Can move money, issue refunds and read customer payment details.",
    "email": "Can send phishing from your verified domain and read delivery logs.",
    "storage": "Read/write access to stored files and user uploads.",
    "analytics": "Can inject fake events and skew metrics; tracked user behaviour may leak.",
    "observability": "Can read logs and traces, which often contain PII and tokens.",
    "compute": "Can deploy arbitrary code to your live site: defacement, phishing or credential harvesting.",
    "hosting": "Can deploy arbitrary code to your live site: defacement, phishing or credential harvesting.",
    "cdn": "Can replace the content your users are served.",
}
DATA_CLASS = {"database": "PII", "auth": "PII", "payments": "PCI", "ai": "Confidential",
              "email": "PII", "analytics": "PII", "observability": "Confidential"}
ENDPOINTS = {"Neon": ["https://console.neon.tech"], "Clerk": ["https://api.clerk.com"],
             "OpenRouter": ["https://openrouter.ai/api/v1"], "PostHog": ["https://eu.posthog.com"],
             "Netlify": ["https://api.netlify.com"], "Supabase": ["https://supabase.com"], "Resend": ["https://api.resend.com"]}


# ---------- Stripe CLI ----------

def stripe(*args, timeout=300):
    """Run `stripe projects ... --json` and return the parsed envelope. Reads stdout only."""
    cmd = ["stripe", "projects", *args, "--json"]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        sys.exit("error: stripe CLI not found on PATH")
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": {"code": "TIMEOUT", "message": f"{' '.join(cmd[:4])} timed out"}}
    out = proc.stdout
    start = out.find("{")  # the CLI may print a hint line before the JSON
    if start < 0:
        return {"ok": False, "error": {"code": "NO_JSON", "message": f"no JSON from {' '.join(cmd[:4])}"}}
    try:
        return json.loads(out[start:])
    except json.JSONDecodeError:
        return {"ok": False, "error": {"code": "BAD_JSON", "message": f"unparseable JSON from {' '.join(cmd[:4])}"}}


def must(envelope, what):
    if not envelope.get("ok"):
        err = envelope.get("error") or {}
        if err.get("code") == "NOT_AUTHENTICATED":
            sys.exit("error: Stripe session expired. Run `stripe login`, then retry.")
        sys.exit(f"error: {what} failed ({err.get('code')}): {err.get('message', '')[:300]}")
    return envelope["data"]


def load_catalog():
    """Catalog is ~500KB and slow; cache it for a day."""
    if CATALOG_CACHE.exists():
        age = dt.datetime.now().timestamp() - CATALOG_CACHE.stat().st_mtime
        if age < 86400:
            return json.loads(CATALOG_CACHE.read_text())
    env = stripe("catalog", timeout=120)
    if not env.get("ok"):
        return {}
    index = {}
    for s in env["data"].get("services", []):
        prov = s.get("provider")
        prov = prov.get("id") if isinstance(prov, dict) else prov
        index[f"{prov}/{s.get('service_id')}"] = {
            "categories": s.get("categories") or [],
            "kind": s.get("kind"),
            "description": (s.get("description") or "")[:200],
            "paid": ((s.get("pricing") or {}).get("paid") or {}).get("freeform"),
        }
    STATE_DIR.mkdir(exist_ok=True)
    CATALOG_CACHE.write_text(json.dumps(index))
    return index


# ---------- ledger ----------

def now():
    return dt.datetime.now(dt.timezone.utc)


def iso(t):
    return t.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


def parse_ts(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00")) if s else None


def load_ledger():
    if LEDGER.exists():
        return json.loads(LEDGER.read_text())
    return {"version": 1, "resources": {}}


def save_ledger(ledger):
    STATE_DIR.mkdir(exist_ok=True)
    LEDGER.write_text(json.dumps(ledger, indent=2))
    os.chmod(LEDGER, 0o600)


# ---------- scan ----------

def fingerprint(preview):
    """Turn the CLI's already-redacted preview into at most 4 chars + '…'."""
    if not preview:
        return "…"
    visible = preview.replace("•", "")
    return visible[:4] + "…"


def grep_refs(var_names):
    refs = {v: [] for v in var_names}
    if not var_names:
        return refs
    pat = re.compile(r"\b(" + "|".join(map(re.escape, var_names)) + r")\b")
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for fn in filenames:
            if fn in SKIP_FILES or fn.startswith(".env"):
                continue
            path = Path(dirpath) / fn
            try:
                text = path.read_text(errors="ignore")
            except OSError:
                continue
            rel = str(path.relative_to(ROOT))
            for m in set(pat.findall(text)):
                refs[m].append(rel)
    return {k: sorted(v) for k, v in refs.items()}


def monthly_cost(pricing_str, catalog_paid):
    p = (pricing_str or "").lower()
    if p.startswith("free"):
        return 0.0, pricing_str
    m = re.search(r"\$(\d+(?:\.\d+)?)\s*(?:/|per\s*)mo", pricing_str or "")
    if m:
        return float(m.group(1)), pricing_str
    return None, pricing_str or catalog_paid or "unknown"


def scan(max_age, quiet=False):
    status = must(stripe("status"), "stripe projects status")
    env = stripe("env")
    if not env.get("ok") and "vault" in ((env.get("error") or {}).get("message") or "").lower():
        stripe("env", "--pull")  # rebuild the machine-local vault (e.g. after re-login), then retry
        env = stripe("env")
    envdata = must(env, "stripe projects env")
    catalog = load_catalog()
    ledger = load_ledger()

    vars_by_res = {}
    previews = {}
    for rac in envdata.get("resource_access_configurations", []):
        vars_by_res[rac["resource_id"]] = rac.get("access_configuration_keys", [])
        previews.update(rac.get("access_configuration") or {})

    resources = [(r, "service") for r in status.get("services", [])] + \
                [(r, "plan") for r in status.get("plans", [])]
    all_vars = [v for r, _ in resources for v in vars_by_res.get(r["id"], [])]
    refs = grep_refs(all_vars)

    items = []
    for r, kind in resources:
        name = r["name"]
        cat = catalog.get(f"{r['provider_id']}/{r['service_id']}", {})
        categories = cat.get("categories") or []
        primary = categories[0] if categories else "other"

        env_vars = vars_by_res.get(r["id"], [])
        secrets = [v for v in env_vars if SECRET_RE.search(v)]
        files = sorted({f for v in env_vars for f in refs.get(v, [])})

        # credential age: simulated > CLI timestamp > ledger first-seen
        entry = ledger["resources"].setdefault(name, {"first_seen": iso(now())})
        cli_issued = r.get("last_revealed_at") or r.get("created_at")
        entry["cli_issued_at"] = cli_issued
        sim = entry.get("simulated")
        if sim and sim.get("cli_issued_at_when_set") != cli_issued:
            entry.pop("simulated")  # credential was re-issued since backdating
            sim = None
        if sim:
            issued, source = parse_ts(sim["issued_at"]), "simulated (sbom demo-age)"
        elif cli_issued:
            issued = parse_ts(cli_issued)
            source = "stripe projects status: last_revealed_at" if r.get("last_revealed_at") else "stripe projects status: created_at"
        else:
            issued, source = parse_ts(entry["first_seen"]), "sbom ledger: first seen"
        age_days = (now() - issued).total_seconds() / 86400
        stale = bool(secrets) and age_days > max_age

        severity = SEVERITY.get(primary, "low")
        impact = IMPACT.get(primary, "Limited impact: provider-specific access.")
        if any("PERSONAL_API_KEY" in v for v in secrets):
            severity = "high"
            impact = "Personal API key grants admin read of all tracked events and user data, plus event injection."
        if not secrets:
            severity = "low"
            impact = "Identifiers and config only; no secret material in this resource."

        cost, cost_label = monthly_cost(r.get("pricing"), cat.get("paid"))
        items.append({
            "name": name, "kind": kind, "provider": r["provider"], "service": r["service_id"],
            "resource_id": r["id"], "categories": categories, "category": primary,
            "plan": r.get("pricing"), "cost": cost, "cost_label": cost_label,
            "env_vars": [{"name": v, "secret": v in secrets,
                          "fingerprint": fingerprint(previews.get(v)) if v in secrets else None,
                          "files": refs.get(v, [])} for v in env_vars],
            "files": files, "issued_at": iso(issued), "age_days": round(age_days, 2),
            "age_source": source, "simulated": bool(sim), "stale": stale,
            "severity": severity, "impact": impact,
            "status": r.get("status"), "created_at": r.get("created_at"),
            "last_rotated_by_sbom": entry.get("last_rotated"),
        })
    save_ledger(ledger)

    items.sort(key=lambda i: (-SEV_RANK[i["severity"]], i["kind"] != "service", i["name"]))
    meta = {"project": status["project"]["name"], "project_id": status["project"]["id"],
            "generated_at": iso(now()), "max_age_days": max_age}
    write_cdx(meta, items)
    write_html(meta, items)
    if not quiet:
        print_table(items, max_age)
        print(f"\nwrote {CDX_OUT.name} and {HTML_OUT.name}")
    return items


# ---------- outputs ----------

def summary(items):
    costs = [i["cost"] for i in items]
    known = sum(c for c in costs if c is not None)
    return {
        "resources": len(items),
        "services": sum(1 for i in items if i["kind"] == "service"),
        "monthly_cost": f"${known:,.2f}" + ("+" if None in costs else ""),
        "stale": sum(1 for i in items if i["stale"]),
        "critical": sum(1 for i in items if i["severity"] == "critical"),
    }


def write_cdx(meta, items):
    services = []
    for i in items:
        props = {
            "sbom:kind": i["kind"],
            "sbom:category": ",".join(i["categories"]) or "other",
            "sbom:plan": i["plan"] or "",
            "sbom:cost:monthly_usd": "" if i["cost"] is None else f"{i['cost']:.2f}",
            "sbom:cost:label": i["cost_label"] or "",
            "sbom:credential:env_vars": ",".join(v["name"] for v in i["env_vars"]),
            "sbom:credential:secret_env_vars": ",".join(v["name"] for v in i["env_vars"] if v["secret"]),
            "sbom:credential:issued_at": i["issued_at"],
            "sbom:credential:age_days": f"{i['age_days']:.1f}",
            "sbom:credential:age_source": i["age_source"],
            "sbom:credential:simulated": str(i["simulated"]).lower(),
            "sbom:credential:stale": str(i["stale"]).lower(),
            "sbom:credential:max_age_days": str(meta["max_age_days"]),
            "sbom:blast_radius:severity": i["severity"],
            "sbom:blast_radius:impact": i["impact"],
            "sbom:blast_radius:referencing_files": ",".join(i["files"]),
            "stripe:projects:resource_id": i["resource_id"],
        }
        services.append({
            "bom-ref": f"service:{i['name']}",
            "provider": {"name": i["provider"]},
            "group": i["provider"],
            "name": i["name"],
            "description": f"{i['provider']} {i['service']} ({i['kind']}) provisioned via Stripe Projects",
            "endpoints": ENDPOINTS.get(i["provider"], []),
            "authenticated": True,
            "x-trust-boundary": True,
            "data": [{"flow": "bi-directional",
                      "classification": DATA_CLASS.get(i["category"], "Internal") if i["env_vars"] else "Public"}],
            "properties": [{"name": k, "value": v} for k, v in props.items()],
        })
    doc = {
        "bomFormat": "CycloneDX",
        "specVersion": "1.5",
        "serialNumber": f"urn:uuid:{uuid.uuid4()}",
        "version": 1,
        "metadata": {
            "timestamp": meta["generated_at"],
            "tools": {"components": [{"type": "application", "name": "sbom", "version": "0.1.0",
                                      "description": "Service Bill of Materials for Stripe Projects"}]},
            "component": {"type": "application", "bom-ref": "app", "name": meta["project"]},
            "properties": [{"name": "stripe:projects:project_id", "value": meta["project_id"]}],
        },
        "services": services,
        "dependencies": [{"ref": "app", "dependsOn": [s["bom-ref"] for s in services]}],
    }
    CDX_OUT.write_text(json.dumps(doc, indent=2))


def fmt_age(days):
    if days < 1 / 24:
        return f"{max(1, round(days * 1440))} min"
    if days < 1:
        return f"{round(days * 24)} h"
    return f"{days:.0f} days"


def print_table(items, max_age):
    s = summary(items)
    print(f"{s['resources']} resources ({s['services']} services) · {s['monthly_cost']}/mo · "
          f"{s['stale']} stale (> {max_age}d) · {s['critical']} critical")
    print(f"{'RESOURCE':20} {'KIND':8} {'RISK':9} {'AGE':10} {'SOURCE':42} STATUS")
    for i in items:
        flag = "STALE" if i["stale"] else "ok"
        sim = " (simulated)" if i["simulated"] else ""
        print(f"{i['name']:20} {i['kind']:8} {i['severity'].upper():9} {fmt_age(i['age_days']):10} "
              f"{(i['age_source'][:40]):42} {flag}{sim}")


