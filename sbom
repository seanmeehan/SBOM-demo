# ---------- rotate / demo-age ----------

def resolve(items, target):
    t = target.lower()
    exact = [i for i in items if i["name"].lower() == t]
    if exact:
        return exact
    # provider name: rotate every resource from that provider that holds secrets
    return [i for i in items if i["provider"].lower() == t and any(v["secret"] for v in i["env_vars"])]


def cmd_rotate(args):
    items = scan(args.max_age, quiet=True)
    if args.stale:
        targets = [i for i in items if i["stale"]]
    elif args.target:
        targets = resolve(items, args.target)
        if not targets:
            sys.exit(f"error: no resource or provider matches '{args.target}'")
    else:
        sys.exit("error: pass --stale or a provider/resource name")
    if not targets:
        print("nothing to rotate: no stale credentials")
        return
    print("Will rotate:")
    for i in targets:
        names = ", ".join(v["name"] for v in i["env_vars"] if v["secret"])
        print(f"  {i['name']:20} {i['severity'].upper():9} age {fmt_age(i['age_days'])}  [{names}]")
    if not args.yes:
        if not sys.stdin.isatty():
            sys.exit("aborted: pass --yes to rotate non-interactively")
        if input("Proceed? [y/N] ").strip().lower() not in ("y", "yes"):
            sys.exit("aborted")

    ledger = load_ledger()
    failed = []
    for i in targets:
        print(f"→ stripe projects rotate {i['name']} … ", end="", flush=True)
        res = stripe("rotate", i["name"], "--yes")
        if res.get("ok"):
            print("done")
            ledger["resources"].setdefault(i["name"], {"first_seen": iso(now())})
            ledger["resources"][i["name"]]["last_rotated"] = iso(now())
            ledger["resources"][i["name"]].pop("simulated", None)
        else:
            err = res.get("error") or {}
            print(f"FAILED ({err.get('code')}): {err.get('message', '')[:200]}")
            failed.append(i["name"])
    save_ledger(ledger)

    print("→ stripe projects env --pull … ", end="", flush=True)
    res = stripe("env", "--pull")
    print("done" if res.get("ok") else f"FAILED ({(res.get('error') or {}).get('code')})")
    print()
    scan(args.max_age)
    if failed:
        sys.exit(f"rotation failed for: {', '.join(failed)}")


def cmd_demo_age(args):
    items = scan(args.max_age, quiet=True)
    targets = resolve(items, args.target)
    if not targets:
        sys.exit(f"error: no resource or provider matches '{args.target}'")
    ledger = load_ledger()
    for i in targets:
        entry = ledger["resources"].setdefault(i["name"], {"first_seen": iso(now())})
        entry["simulated"] = {"issued_at": iso(now() - dt.timedelta(days=args.days)),
                              "set_at": iso(now()),
                              "cli_issued_at_when_set": entry.get("cli_issued_at")}
        print(f"backdated {i['name']} to {args.days} days old (simulated)")
    save_ledger(ledger)
    scan(args.max_age)


# ---------- vulns: package SBOM -> OSV.dev ----------

def cvss3(vec):
    if not vec or not vec.startswith("CVSS:3"):
        return None
    m = dict(x.split(":") for x in vec.split("/")[1:] if ":" in x)
    try:
        changed = m["S"] == "C"
        av = {"N": .85, "A": .62, "L": .55, "P": .2}[m["AV"]]
        ac = {"L": .77, "H": .44}[m["AC"]]
        ui = {"N": .85, "R": .62}[m["UI"]]
        pr = {"N": .85, "L": .68 if changed else .62, "H": .5 if changed else .27}[m["PR"]]
        c, i, a = ({"H": .56, "L": .22, "N": 0}[m[k]] for k in ("C", "I", "A"))
    except KeyError:
        return None
    iss = 1 - (1 - c) * (1 - i) * (1 - a)
    impact = 7.52 * (iss - .029) - 3.25 * (iss - .02) ** 15 if changed else 6.42 * iss
    if impact <= 0:
        return 0.0
    base = (impact + 8.22 * av * ac * pr * ui) * (1.08 if changed else 1)
    return __import__("math").ceil(min(base, 10) * 10 - 1e-9) / 10


def vuln_severity(v):
    score = cvss3(next((s["score"] for s in v.get("severity", []) if s.get("type") == "CVSS_V3"), None))
    ds = ((v.get("database_specific") or {}).get("severity") or "").lower()
    if ds:
        return ("medium" if ds == "moderate" else ds), score
    if score is None:
        return "unknown", None
    return ("critical" if score >= 9 else "high" if score >= 7 else "medium" if score >= 4 else "low"), score


def sbom_packages(doc):
    if doc.get("bomFormat") == "CycloneDX":
        out, stack = [], list(doc.get("components") or [])
        while stack:
            c = stack.pop()
            out.append(c.get("purl"))
            stack.extend(c.get("components") or [])
        return out
    if doc.get("spdxVersion"):
        return [next((r.get("referenceLocator") for r in p.get("externalRefs") or []
                      if (r.get("referenceType") or "").lower() == "purl"), None) for p in doc.get("packages") or []]
    sys.exit("error: not a CycloneDX or SPDX JSON document")


def osv(path, body=None):
    import urllib.request
    req = urllib.request.Request("https://api.osv.dev/v1/" + path, method="POST" if body else "GET",
                                 data=json.dumps(body).encode() if body else None,
                                 headers={"content-type": "application/json", "user-agent": "sbom-cli"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def cmd_vulns(args):
    from concurrent.futures import ThreadPoolExecutor
    doc = json.loads(Path(args.file).read_text())
    purls = sbom_packages(doc)
    queryable = [p.split("?")[0] for p in purls if p and p.startswith("pkg:") and "@" in p]
    if doc.get("services") and not purls:
        sys.exit("this is a service SBoM (no packages); run `sbom scan` for services")
    print(f"Checking {len(queryable)} packages against OSV.dev …")
    res = []
    for k in range(0, len(queryable), 500):
        chunk = queryable[k:k + 500]
        out = osv("querybatch", {"queries": [{"package": {"purl": p}} for p in chunk]})
        res += [(p, [v["id"] for v in r.get("vulns") or []]) for p, r in zip(chunk, out["results"])]
    ids = sorted({i for _, vs in res for i in vs})
    with ThreadPoolExecutor(8) as ex:
        details = dict(zip(ids, ex.map(lambda i: osv(f"vulns/{i}"), ids)))
    rows = []
    for purl, vids in res:
        seen = set()
        for vid in vids:
            v = details[vid]
            keys = {vid, *(v.get("aliases") or [])}
            if keys & seen:
                continue  # same CVE published under several advisory ids
            seen |= keys
            sev, score = vuln_severity(v)
            cve = next((a for a in v.get("aliases") or [] if a.startswith("CVE-")), vid)
            rows.append((SEV_RANK.get(sev, 0), score or 0, purl, sev, score, cve, v.get("summary") or ""))
    rows.sort(key=lambda r: (-r[0], -r[1]))
    vulnerable = {r[2] for r in rows}
    count = lambda s: sum(1 for r in rows if r[3] == s)
    print(f"{len(purls)} packages · {len(vulnerable)} vulnerable · {len(rows)} known vulnerabilities · "
          f"{count('critical')} critical · {count('high')} high")
    shown = rows if args.all else [r for r in rows if r[3] in ("critical", "high")]
    for _, _, purl, sev, score, cve, summ in shown:
        name = purl[4:]
        print(f"  {sev.upper():9}{(f'{score:.1f}' if score else ''):5} {cve:18} {name[:52]:52} {summ[:56]}")
    if len(shown) < len(rows):
        print(f"  … {len(rows) - len(shown)} medium/low not shown (use --all)")
    if unscannable := len(purls) - len(queryable):
        print(f"{unscannable} component(s) had no purl and were skipped")


def read_env_value(key):
    """Read one value from .env for in-process use only. Never printed or logged."""
    for line in (ROOT / ".env").read_text().splitlines():
        k, sep, val = line.partition("=")
        if sep and k.strip().removeprefix("export ").strip() == key:
            return val.strip().strip('"').strip("'")
    return None


def cmd_deploy(args):
    import io
    import urllib.request
    import zipfile
    site = ROOT / "site"
    if CDX_OUT.exists():  # publish the latest service SBoM, minus Stripe account/resource ids
        doc = json.loads(CDX_OUT.read_text())
        doc["metadata"].pop("properties", None)
        for s in doc.get("services", []):
            s["properties"] = [p for p in s.get("properties", []) if not p["name"].startswith("stripe:")]
        (site / "samples" / "services.cdx.json").write_text(json.dumps(doc, indent=2))
    token, site_id = read_env_value("NETLIFY_NETLIFY_AUTH_TOKEN"), read_env_value("NETLIFY_NETLIFY_SITE_ID")
    if not (token and site_id):
        stripe("env", "--pull")
        token, site_id = read_env_value("NETLIFY_NETLIFY_AUTH_TOKEN"), read_env_value("NETLIFY_NETLIFY_SITE_ID")
    if not (token and site_id):
        sys.exit("error: Netlify credentials missing; run `stripe projects add netlify/project --name sbom-site`")
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as z:
        for f in sorted(site.rglob("*")):
            if f.is_file():
                z.write(f, f.relative_to(site).as_posix())
    print(f"→ uploading site/ ({buf.tell() // 1024} KB) to Netlify … ", end="", flush=True)
    req = urllib.request.Request(f"https://api.netlify.com/api/v1/sites/{site_id}/deploys", data=buf.getvalue(),
                                 method="POST", headers={"Authorization": f"Bearer {token}",
                                                         "Content-Type": "application/zip", "User-Agent": "sbom-cli"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            dep = json.load(r)
    except urllib.error.HTTPError as e:
        sys.exit(f"FAILED (HTTP {e.code})")
    print("done")
    print(f"live at {dep.get('ssl_url') or dep.get('url')}")


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--max-age", type=int, default=DEFAULT_MAX_AGE, help="stale threshold in days (default 30)")
    ap = argparse.ArgumentParser(prog="sbom", description="Service Bill of Materials for Stripe Projects")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("scan", parents=[common], help="inventory services, write sbom.cdx.json + report.html")
    r = sub.add_parser("rotate", parents=[common], help="rotate credentials via stripe projects rotate")
    r.add_argument("target", nargs="?", help="provider (e.g. neon) or resource (e.g. neon-postgres)")
    r.add_argument("--stale", action="store_true", help="rotate every STALE credential")
    r.add_argument("--yes", "-y", action="store_true", help="skip confirmation")
    d = sub.add_parser("demo-age", parents=[common], help="backdate a credential for demos (labelled simulated)")
    d.add_argument("target")
    d.add_argument("days", type=int)
    v = sub.add_parser("vulns", help="check a package SBOM (CycloneDX/SPDX JSON) against OSV.dev")
    v.add_argument("file")
    v.add_argument("--all", action="store_true", help="also list medium/low findings")
    sub.add_parser("deploy", help="publish site/ (scanner + latest service SBoM) to Netlify")
    args = ap.parse_args()
    {"scan": lambda a: scan(a.max_age), "rotate": cmd_rotate, "demo-age": cmd_demo_age,
     "vulns": cmd_vulns, "deploy": cmd_deploy}[args.cmd](args)


if __name__ == "__main__":
    main()
